-- =========================================================
-- Duplicate-row checks across the tables we've been working with
-- Returns the FULL row for every duplicate found
-- =========================================================

-- voicemail: no unique constraint on mailbox, so duplicates
-- (same mailbox + context) are possible in practice
SELECT *
FROM public.voicemail v
WHERE (mailbox, context) IN (
    SELECT mailbox, context
    FROM public.voicemail
    GROUP BY mailbox, context
    HAVING COUNT(*) > 1
)
ORDER BY mailbox, context;


-- ps_aors: id has a UNIQUE constraint, so this should always
-- return zero rows -- included for completeness / sanity check
SELECT *
FROM public.ps_aors a
WHERE id IN (
    SELECT id
    FROM public.ps_aors
    GROUP BY id
    HAVING COUNT(*) > 1
)
ORDER BY id;


