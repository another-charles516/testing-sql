FROM public.time_rules t
WHERE (rule_type,display_note,context_name,created_by,is_active,is_recurring,
       recur_dow,recording_to_play,hard_datetime_begin,hard_datetime_end,
       recur_time_begin,recur_time_end,created) IN (
