           recur_dow,recording_to_play,hard_datetime_begin,hard_datetime_end,
           recur_time_begin,recur_time_end,created
    FROM public.time_rules
    GROUP BY rule_type,display_note,context_name,created_by,is_active,is_recurring,
             recur_dow,recording_to_play,hard_datetime_begin,hard_datetime_end,
             recur_time_begin,recur_time_end,created
