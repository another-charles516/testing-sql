-- sound_files: PRIMARY KEY is sound_id (auto-increment), but
-- filename itself has NO unique constraint -- duplicate filenames
-- ARE possible here even though logically each should be unique
SELECT *
FROM public.sound_files s
WHERE filename IN (
    SELECT filename
    FROM public.sound_files
    GROUP BY filename
    HAVING COUNT(*) > 1
)
ORDER BY filename;


-- time_rules: PRIMARY KEY is rule_id, so exact rule_id duplicates
-- can't exist. This instead checks for duplicate SCHEDULE definitions
-- (same rule_type/context/day-of-week/time window), which would be
-- functionally redundant rules even with different rule_ids.
-- Adjust the GROUP BY columns if a different definition of
-- "duplicate" is what you're after.
SELECT *
FROM public.time_rules t
WHERE (rule_type, context_name, recur_dow, recur_time_begin, recur_time_end) IN (
    SELECT rule_type, context_name, recur_dow, recur_time_begin, recur_time_end
    FROM public.time_rules
    GROUP BY rule_type, context_name, recur_dow, recur_time_begin, recur_time_end
    HAVING COUNT(*) > 1
)
ORDER BY rule_type, recur_dow;


-- =========================================================
-- FULL-ROW duplicate checks: compares every column (except each
-- table's own auto-generated surrogate key, which can never repeat
-- and would otherwise make every row look "unique")
-- =========================================================

-- voicemail (excludes uniqueid)
SELECT *
FROM public.voicemail v
WHERE (context,mailbox,password,fullname,alias,email,pager,attach,attachfmt,
       serveremail,language,tz,deletevoicemail,saycid,sendvoicemail,review,
       tempgreetwarn,operator,envelope,sayduration,forcename,forcegreetings,
       callback,dialout,exitcontext,maxmsg,volgain,imapuser,imappassword,
       imapserver,imapport,imapflags,stamp) IN (
    SELECT context,mailbox,password,fullname,alias,email,pager,attach,attachfmt,
           serveremail,language,tz,deletevoicemail,saycid,sendvoicemail,review,
           tempgreetwarn,operator,envelope,sayduration,forcename,forcegreetings,
           callback,dialout,exitcontext,maxmsg,volgain,imapuser,imappassword,
           imapserver,imapport,imapflags,stamp
    FROM public.voicemail
    GROUP BY context,mailbox,password,fullname,alias,email,pager,attach,attachfmt,
             serveremail,language,tz,deletevoicemail,saycid,sendvoicemail,review,
             tempgreetwarn,operator,envelope,sayduration,forcename,forcegreetings,
             callback,dialout,exitcontext,maxmsg,volgain,imapuser,imappassword,
             imapserver,imapport,imapflags,stamp
    HAVING COUNT(*) > 1
)
ORDER BY mailbox;


