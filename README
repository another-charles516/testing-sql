SELECT
    C.DEBTOR_ID,
    V.NAME1,
    V.STATUS_CODE,
    MIN(X.ORIG_CLT) AS CLT,
    C.COMPLIANCE_CODE,
    CC.COMPLIANCE_DESCR,
    CASE
        WHEN C.STATUS IS NULL THEN 'OPEN'
        WHEN C.STATUS = 'R' THEN 'RESOLVED'
        ELSE C.STATUS
    END AS COMPLAINT_STATUS,
    C.ISSUE_TEXT,
    C.CREATED_DATE,
    C.CREATED_USER,
    C.TIME_STAMP AS COMPLAINT_TIMESTAMP,
    V.CUR_STATE,
    V.ASSIGN_ID
FROM
    DM.DBTR_COMPLAINT C
LEFT JOIN
    DM.DBTR_VIEW V
    ON C.DEBTOR_ID = V.DEBTOR_ID
LEFT JOIN
    DM.COMPLIANCE_CODES CC
    ON C.COMPLIANCE_CODE = CC.COMPLIANCE_CODE
LEFT JOIN
    DM.DBTRXDBT_SUBVIEW X
    ON C.DEBTOR_ID = X.DEBTOR_ID
WHERE
    C.CREATED_DATE BETWEEN '2025/01/01' AND '2050/06/30'
GROUP BY
    C.DEBTOR_ID,
    V.NAME1,
    V.STATUS_CODE,
    C.COMPLIANCE_CODE,
    CC.COMPLIANCE_DESCR,
    C.STATUS,
    C.ISSUE_TEXT,
    C.CREATED_DATE,
    C.CREATED_USER,
    C.TIME_STAMP,
    V.CUR_STATE,
    V.ASSIGN_ID;
