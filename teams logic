[teams-transfer]
exten = _XXXX,1,Set(ZULU=${EXTEN})
  same => n,GotoIf($[${DIALPLAN_EXISTS(zulu-lookup,${ZULU},1)}]?found)
  same => n,NoOp(No Teams DID for ${ZULU})
  same => n,hangup()
  same => n(found),Gosub(zulu-lookup,${ZULU},1)
  same => n,Set(TEAMSDID=${GOSUB_RETVAL})
  same => n,Set(trunkid=${IF($["${PJSIP_CONTACT(${PJSIP_AOR(SipService2,contact)},status)}"="Reachable"]?2:1)})
  same => n,NoOp(ZULU=${ZULU} DID=${TEAMSDID} caller id = ${CALLERID(all)})
  same => n,Dial(PJSIP/${OUTPREFIX}${TEAMSDID}@${TRUNK}${trunkid},,TtkKwWr(ring))
  same => n,gosub(errorcheck,1)
  same => n,hangup()

